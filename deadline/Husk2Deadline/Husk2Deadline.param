[About]
Description=Renders USD stages directly with SideFX husk (Karma / any Hydra delegate).
Author=Custom Studio Plugin
Version=1.0

[HuskExecutable]
Type=multifilename
Label=Husk Executable
Description=Fallback path to husk (usually <Houdini>/bin/husk.exe or husk on Linux). Jobs submitted from Houdini inject their own HuskExecutable based on the build that was used, so this value is only needed for old jobs or manual submissions.
DefaultValue=

[Plugin]
Type=string
Label=Plugin Name
DefaultValue=Husk2Deadline
Disabled=true
